# Allow-list for `gcloud run deploy --source`: upload only what the image build needs.
/*
!/Dockerfile
!/.dockerignore
!/api/
!/web/
!/demo_cases/
demo_cases/**/*.pdf
demo_cases/**/*.jpg
demo_cases/**/*.md
api/.venv/
api/tests/
api/.*_cache/
web/node_modules/
web/dist/
web/coverage/
web/playwright-report/
web/test-results/
**/__pycache__/
