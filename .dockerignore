# Allow-list: only what the image build needs.
*
!Dockerfile
!api/pyproject.toml
!api/uv.lock
!api/src/
!web/
# The parent must be re-included explicitly, or the builder never walks into demo_cases/.
# Everything replay mode needs ships: recordings, extractions, narration audio, documents.
!demo_cases/
demo_cases/**/*.md
web/node_modules/
web/dist/
web/coverage/
web/playwright-report/
web/test-results/
**/__pycache__/
